# Configuration de l'application
VITE_APP_TITLE=Portfolio 3D
VITE_APP_DESCRIPTION=Mon portfolio avec des animations 3D
VITE_APP_VERSION=1.0.0

# Configuration de l'API (si nécessaire)
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=5000

# Configuration de déploiement
VITE_DEPLOYMENT_URL=http://your-raspberry-pi-ip

# Configuration des animations
VITE_ANIMATION_DURATION=1000
VITE_ANIMATION_DELAY=200

# Configuration Spline (si utilisé)
VITE_SPLINE_SCENE_URL=https://prod.spline.design/your-scene-url

# Configuration AOS (Animate On Scroll)
VITE_AOS_OFFSET=120
VITE_AOS_DELAY=100
VITE_AOS_DURATION=800
